[Unit]
Description=Linux Hardener security agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/linux-hardener
ExecStart=/opt/linux-hardener/.venv/bin/linux-hardener-agent --interval 900 --server http://127.0.0.1:8000/api/scans
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
